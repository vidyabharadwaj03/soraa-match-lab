# Copy to .env and fill in. .env is gitignored.
ARCHIL_API_KEY=key-...          # console.archil.com/api-keys (create it in the same region as below)
ARCHIL_REGION=aws-us-east-1
ANTHROPIC_API_KEY=sk-ant-...    # the agents' model
KEENABLE_API_KEY=               # optional: search/fetch also work keyless; a key raises rate limits
# FLEET_MODEL=claude-haiku-5-5  # default, cheapest. e.g. claude-sonnet-5-5 for better writing
# ARCHIL_DISK_ID=               # optional: use a specific disk instead of the shared "soraa-fleet" one
# MAX_CREATORS=4
